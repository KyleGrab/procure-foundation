ENVIRONMENT=development

# Postgres
# ADR-011: two separate credentials, on purpose - the app must never connect with the same
# privileges used to run migrations. DATABASE_URL/_SYNC are admin-level (used only by
# alembic/env.py). DATABASE_URL_APP is the least-privilege procureiq_app role migration 0004
# creates - db/session.py uses this one for every request. In production these are two genuinely
# different secrets managed separately; the values below are local-dev-only and match migration
# 0004's hardcoded dev password (see that file's docstring - production must rotate it).
DATABASE_URL=postgresql+asyncpg://procureiq:procureiq@localhost:5432/procureiq
DATABASE_URL_SYNC=postgresql+psycopg://procureiq:procureiq@localhost:5432/procureiq
DATABASE_URL_APP=postgresql+asyncpg://procureiq_app:procureiq_app_dev_only_rotate_in_production@localhost:5432/procureiq

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=changeme-generate-a-real-secret-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Object storage (S3-compatible; MinIO locally)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=procureiq-uploads
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# AI provider
LLM_PROVIDER=anthropic
LLM_API_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000

# D-01 demo hardening - both default true, production behaviour unchanged unless explicitly set.
# Set both to false only in a controlled demo environment.
ALLOW_SELF_REGISTRATION=true
ENABLE_API_DOCS=true
# Also set NEXT_PUBLIC_ALLOW_SELF_REGISTRATION=false on the frontend to match - UX only, the
# backend setting above is the actual control.

# Required only by app/db/seeds/demo_hardened_seed.py - never given a default, that script
# refuses to run without it.
DEMO_USER_PASSWORD=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# White-label gateway branding (frontend/src/lib/branding.ts) - all optional, every field falls
# back to the current deployment's real default (PPS Logistics) if unset. Only read by Next.js
# when placed in frontend/.env.local (Next.js convention) - this root .env is what
# docker-compose's frontend service reads via env_file, but `npm run dev` run directly does not
# read this file, only frontend/.env.local.
NEXT_PUBLIC_CLIENT_BRAND_NAME=PPS Logistics
NEXT_PUBLIC_CLIENT_BRAND_PRIMARY_COLOR=#6366F1
NEXT_PUBLIC_CLIENT_BRAND_LOGO_URL=
NEXT_PUBLIC_CLIENT_BRAND_LOGO_ALT=
NEXT_PUBLIC_CLIENT_BRAND_TRUCK_IMAGE_URL=/images/pps-logistics-truck-side-removebg-preview.png
NEXT_PUBLIC_CLIENT_BRAND_WORKER_IMAGE_URL=/images/pps-logistics-worker-front-removebg-preview.png
